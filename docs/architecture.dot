digraph AutoHLA {
  rankdir=TB; splines=ortho; nodesep=0.35; ranksep=0.45;
  graph [fontname="DejaVu Sans", fontsize=11, bgcolor="#ffffff", compound=true];
  node  [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#7f8c8d", fillcolor="#ecf0f1", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#5d6d7e", arrowsize=0.7];

  label=<<b>AutoHLA (public) — kiến trúc sau fix</b><br/><font point-size="9">dist/autohla-public · autohla train | autohla impute</font>>;
  labelloc=t; fontsize=15;

  subgraph cluster_train {
    label=<<b>autohla train</b>>; style="rounded,filled"; fillcolor="#f7fbfd"; color="#2980b9"; fontcolor="#2980b9";

    vcf   [label="train.vcf.gz\n+ labels.csv (4-digit)\n+ marker-list", shape=folder, fillcolor="#fdebd0", color="#e67e22"];
    cfg   [label="RunConfig.from_vcf\nphase=auto → OFF (opt-in)\nuse_pair / use_ridge nếu n<4000\nphase_skip = DPB1", fillcolor="#fef9e7", color="#f1c40f"];
    ds    [label="load_dataset\n2 kênh: dosage = OR+AND, missing\n(cM & stem đã gỡ)", fillcolor="#eaf2f8"];
    hold  [label="_holdout: val = 5% train\n(kfold_by_sample, seed 77)", fillcolor="#eaf2f8"];

    subgraph cluster_s1 {
      label="S1 pretext (bỏ được: --no-s1, đo null trên F1)"; style="rounded,filled"; fillcolor="#eef7ee"; color="#27ae60"; fontcolor="#27ae60"; fontsize=10;
      corrupt [label="corrupt: mask 5% marker\n(dosage→0, missing→1)", fillcolor="#e8f6ef"];
      bb1     [label="CoNetBackbone\nenc1 k64/s2 → enc2 k64/s2\ndec1/dec2 k63 → LayerNorm", fillcolor="#d5f5e3"];
      rh      [label="ReconstructionHead\nConv1d(64→3): dosage {0,1,2}", fillcolor="#e8f6ef"];
      s1ck    [label="s1.pt\nbackbone + recon_head", shape=note, fillcolor="#ffffff"];
      corrupt -> bb1 -> rh -> s1ck;
    }

    subgraph cluster_s2 {
      label="S2 curriculum (warm-start từ S1)"; style="rounded,filled"; fillcolor="#fdf2f7"; color="#8e44ad"; fontcolor="#8e44ad"; fontsize=10;
      st1 [label="Giai đoạn 1 — 2-digit\nBCE, rare_bce = 0", fillcolor="#f5eef8"];
      st2 [label="Giai đoạn 2 — 4-digit\nrare-weighted BCE, w ≤ 10", fillcolor="#f5eef8"];
      net [label=<<b>AutoNet</b><br/>backbone → flatten → shared Linear 256<br/>LayerNorm · GELU · Dropout 0.1<br/>HLA_Blocks/gene: fc1→bn→fc2→bn→fc3→sigmoid>, fillcolor="#e8daef", color="#8e44ad"];
      st1 -> st2 [label="warm-start,\ngieo lại seed"];
      st2 -> net [label="model.train()\nNGOÀI vòng epoch"];
    }

    subgraph cluster_ph {
      label="Tầng hậu nghiệm (tắt bằng --no-posthoc; chỉ bật khi n_train < 4000)"; style="rounded,filled"; fillcolor="#fdf6ec"; color="#d35400"; fontcolor="#d35400"; fontsize=10;
      oof  [label="_oof_arms — 10-fold OOF\nmỗi fold train lại từ đầu\n(base memorize train ⇒ cấm fit trên train)", fillcolor="#fae5d3"];
      pairA[label=<<b>Arm nền</b>: pair<br/>fine-tune BẢN SAO net + PairEnergyHead<br/>rank 16, cặp KHÔNG thứ tự<br/>loss = BCE + 0.2·pair_loss<br/>lr 1e-4 (trunk) / 5e-4 (head)<br/>early-stop theo F1 bin &lt;1%>, fillcolor="#fdebd0"];
      ridgeA[label=<<b>Arm phụ</b>: ridge trên z (256-d)<br/>z-score → chọn λ trên val<br/>đọc z của trunk NỀN, không phải trunk pair>, fillcolor="#fdebd0"];
      beta [label="fit_beta trên dự đoán OOF\ns = norm( p_nền^(1-β) · p_phụ^β )\nβ TÁCH rare/common, af_split = 0.20", fillcolor="#f8c471", color="#d35400"];
      tau  [label="tune_tau trên val 5%\nbội số dị hợp; HW τ=2 là fallback\nfit trên ĐÚNG phân bố lúc impute", fillcolor="#f8c471", color="#d35400"];
      oof -> pairA; oof -> ridgeA; pairA -> beta; ridgeA -> beta; beta -> tau;
    }

    model [label=<<b>model/</b><br align="left"/>manifest.json — config, n_train, β, τ, freq (AF train)<br align="left"/>markers.tsv — marker đóng băng<br align="left"/>encoder.pkl — allele universe (pickle!)<br align="left"/>trunk.pt · head.pt · [pair.pt] · [ridge.npz]<br align="left"/>>, shape=folder, fillcolor="#d6eaf8", color="#2980b9"];

    vcf -> cfg -> ds -> hold;
    hold -> corrupt [lhead=cluster_s1];
    hold -> st1 [lhead=cluster_s2];
    s1ck -> st1 [label="nạp backbone"];
    net -> oof [lhead=cluster_ph];
    net -> model; tau -> model;
  }

  subgraph cluster_imp {
    label=<<b>autohla impute</b> — gọi 1 mẫu KHÔNG phụ thuộc mẫu khác trong lô>; style="rounded,filled"; fillcolor="#f6fbf6"; color="#16a085"; fontcolor="#16a085";
    tvcf [label="test.vcf.gz", shape=folder, fillcolor="#fdebd0", color="#e67e22"];
    chk  [label="chồng lấn marker ≥ 50%\nkhông đạt → dừng, không trả rác", shape=diamond, fillcolor="#fadbd8", color="#c0392b"];
    fwd  [label="load_dataset (markers.tsv)\nAutoNet → score, z", fillcolor="#e8f8f5"];
    base [label="nền = dosage của pair (nếu có)\nngược lại = to_prob(score)", fillcolor="#e8f8f5"];
    bl   [label="blend(β_rare, β_common)\nAF lấy từ manifest.freq\nKHÔNG ước lượng lại từ lô", fillcolor="#d1f2eb"];
    dec  [label="map_diploid_pairs(top-5, τ)\nP(hom)=p², P(het)=τ·p_i·p_j", fillcolor="#d1f2eb"];
    out  [label="calls.csv\nsample_id, gene, allele_1, allele_2, posterior", shape=note, fillcolor="#ffffff"];
    tvcf -> chk -> fwd -> base -> bl -> dec -> out;
  }

  model -> chk [style=dashed, color="#2980b9", label="  markers, encoder,\n  β, τ, freq, trọng số"];

  dead [label=<<b>Đã đo và LOẠI khỏi bản public</b><br/>kênh cM · lớp stem phi tuyến · cross-attention decoder<br/>TF blocks · pair MLP scorer · pair prior · SWA<br/>Phaser học được (switch-error cliff) · HLA_DPA1<br/>nhánh use_cross_validation của hla_train>,
        shape=box, style="filled,dashed", fillcolor="#f4f6f6", color="#95a5a6", fontcolor="#7f8c8d"];
  out -> dead [style=invis];
}
